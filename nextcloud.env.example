# Copy to /root/nextcloud.env with owner root:root and mode 600, then EDIT.
# This is trusted Bash code, not a Docker .env file. Never use untrusted input.
# All example domains/IPs/secrets below are PLACEHOLDERS.

NEXTCLOUD_DOMAIN='cloud.example.com'
TALK_DOMAIN='talk.example.com'
TURN_DOMAIN='talk.example.com'       # May equal TALK_DOMAIN (recommended).
EMAIL='admin@example.com'
PUBLIC_IP='203.0.113.10'             # REPLACE: real static public IPv4.
LOCAL_IP=''                        # Auto-detect interface IP, or set explicitly.

# DNS server already configured to accept TSIG-signed RFC2136 updates.
# It must serve the PUBLIC authoritative DNS view used for DNS-01 validation.
DNS_SERVER='192.0.2.53'             # REPLACE: authoritative update server IP.
DNS_PORT=53
DNS_KEY_NAME='nextcloud-acme.'
DNS_KEY_SECRET='REPLACE_WITH_EXISTING_BASE64_TSIG_SECRET'
DNS_ALGORITHM='HMAC-SHA256'          # Must match the key on the DNS server.
DNS_SIGN_QUERY=false               # true may be needed for key-based BIND views.
DNS_PROPAGATION_SECONDS=120
DNS_CHECK_RESOLVER='1.1.1.1'        # Public recursive resolver for A/AAAA checks.

# Preserve your actual SSH listener. Change this if SSH is not on port 22.
SSH_PORT=22
MANAGE_UFW=1                       # 0: manage all firewall rules yourself.

# Initial deployment version selection; reruns DO NOT upgrade Nextcloud/HPB.
NC_MAJOR=35
NC_VERSION=''                      # Empty: latest stable patch within NC_MAJOR.
HPB_IMAGE='strukturag/nextcloud-spreed-signaling:2.1.1'
ADMIN_USER='ncadmin'                # Initial random password is generated.
PHP_MAX_CHILDREN=6
DEFAULT_PHONE_REGION=''            # Optional ISO alpha-2, for example NL or RU.

# Increase together with provider firewall/NAT rules after capacity planning.
JANUS_MIN_PORT=20000
JANUS_MAX_PORT=20199
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
